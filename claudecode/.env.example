# ------------------------------------------------------------------
# Classify DJ — variáveis de ambiente
# Copie para .env.local e preencha. Sem estas variáveis o site roda em
# MODO DEMONSTRAÇÃO (dados fictícios salvos apenas no navegador).
# ------------------------------------------------------------------

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (segura para o navegador; protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada nos links de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA coloque a service_role key em variáveis NEXT_PUBLIC_*.
# Ela não é necessária para rodar o app.
